# Same Supabase project used by UseAuth. Run supabase/migrations/001_finance.sql there.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Deployed UseAuth origin, without trailing slash.
AUTH_SERVICE_URL=https://your-auth-service.vercel.app
# Deployed S3Sync origin, without trailing slash. Optional until attachments are used.
S3_SYNC_URL=https://your-s3-service.vercel.app
